# ---------------------------------------------------------------------------
# SECURITY-CRITICAL. Read SECURITY.md before relaxing anything here.
# Client work product and any credential must never reach this repository.
# ---------------------------------------------------------------------------

# Client job workspaces - may contain client-confidential material (spec section 22, 33)
workspaces/
jobs_private/
client_files/

# Secrets and sessions
.env
.env.*
!.env.example
*.pem
*.key
!**/public*.key
credentials.json
token.json
*_token.txt
cookies.txt
*.cookies
.mcp-auth/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Generated site output (built by CI, pushed to the dashboard repo)
site/

# Browser-test output. Screenshots are evidence of a run, not source: they are large,
# they go stale the moment the dashboard changes, and re-running the test regenerates them.
runs/screens/

# A locally-run `aicc worker-proof` records itself here. It is a self-report from one machine
# with no provenance anyone checked - a diagnostic, not the repository's state. The validated
# verdict lives in data/worker_proof.json and is written only by the border guard in health.yml.
# Keeping this one out of git is the second lock; src/aicc/worker_proof.py is the first.
data/worker_proof_local.json

# Local scratch
scratchpad/
_to_delete/
*.tmp
.DS_Store
